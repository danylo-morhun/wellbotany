[Unit]
Description=Well Botany: payment reminders for unpaid prepaid orders (regulamin §5)
After=wellbotany.service

[Service]
Type=oneshot
User=deploy
EnvironmentFile=/srv/wellbotany/shared/.env.production.local
ExecStart=/bin/sh -c "curl -fsS --max-time 120 -H \"Authorization: Bearer $${CRON_SECRET}\" http://127.0.0.1:3000/api/cron/payment-reminders"
