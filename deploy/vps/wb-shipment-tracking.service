[Unit]
Description=Well Botany: parcel states from epaka (shipped, delivered, problems)
After=wellbotany.service

[Service]
Type=oneshot
User=deploy
EnvironmentFile=/srv/wellbotany/shared/.env.production.local
ExecStart=/bin/sh -c "curl -fsS --max-time 240 -H \"Authorization: Bearer $${CRON_SECRET}\" http://127.0.0.1:3000/api/cron/shipment-tracking"
