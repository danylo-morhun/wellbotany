# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database (Neon/Supabase Postgres) — REQUIRED ---
# Pooled connection string (via PgBouncer), used by the app at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
# Direct (non-pooled) connection string, used by Prisma migrations.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (NextAuth v5) — REQUIRED ---
# Random 32+ byte secret used to sign session JWTs. Generate: openssl rand -base64 32
AUTH_SECRET=""
# Canonical origin NextAuth uses for callback URLs (e.g. https://twojezdrowie.pl).
AUTH_URL=""

# --- Przelewy24 (payments) — REQUIRED for real checkout ---
# Merchant/shop credentials from the P24 panel (sandbox or production).
P24_MERCHANT_ID=""
P24_POS_ID=""
P24_API_KEY=""
P24_CRC=""
# "true" targets the P24 sandbox API instead of production.
P24_SANDBOX="true"
# DEV/TEST ONLY. "true" skips P24 transaction registration entirely during
# checkout (order is created as PAYMENT_PENDING, no gateway call, no signature
# check). Never set to "true" in production — it lets checkout complete with
# zero payment verification.
P24_SANDBOX_BYPASS=""

# --- BaseLinker (integration hub: Allegro sync, InPost/DHL/DPD labels, stock) ---
# Required for BaseLinker sync (order push, inventory, webhook) to work at all;
# without it those calls run with an empty/zero id and fail upstream.
BASELINKER_API_KEY=""
BASELINKER_INVENTORY_ID=""
BASELINKER_WAREHOUSE_ID=""
BASELINKER_NEW_ORDER_STATUS_ID=""
# REQUIRED to accept BaseLinker webhook calls — missing secret rejects all
# incoming webhook requests with 401 (fails safe, not a silent no-op).
BASELINKER_WEBHOOK_SECRET=""

# --- Shoper (supplier product import source, feeds BaseLinker) ---
# Optional — without both, the Shoper import source reports itself unavailable
# and is skipped; other supplier parsers (Kenay, Yango, Pure Hydration) are unaffected.
SHOPER_API_BASE_URL=""
SHOPER_API_TOKEN=""
# Informational only (surfaced in the /api/shoper/diag endpoint), not used to gate requests.
SHOPER_CLIENT_ID=""

# --- Cron ---
# REQUIRED to authorize the Shoper sync cron endpoint — missing secret rejects
# all calls with 401.
CRON_SECRET=""

# --- Rate limiting (Upstash Redis) ---
# Optional — if either is unset, rate limiting on login/register/checkout/coupon
# actions no-ops (requests are allowed through unlimited) instead of erroring.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Email (Resend) ---
# Optional — if unset, the email client returns null and order confirmation
# emails are silently skipped (no error).
RESEND_API_KEY=""
# Optional — falls back to a hardcoded "Twoje Zdrowie <zamowienia@twojezdrowie.pl>" sender.
RESEND_FROM_EMAIL=""

# --- Cloudinary (admin image uploads) ---
# Optional but uploads fail at runtime if unset — no build-time guard.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- Sentry (error tracking) ---
# Optional — if unset, Sentry init is skipped entirely (server and client).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- Site URLs ---
# Optional — falls back to deriving the origin from request headers.
NEXT_PUBLIC_APP_URL=""
# Optional — falls back to hardcoded "https://twojezdrowie.pl" (used in SEO/sitemap/robots).
NEXT_PUBLIC_SITE_URL=""

# --- Platform-provided, no action needed ---
# NODE_ENV, VERCEL_ENV, NEXT_PUBLIC_VERCEL_ENV are set automatically by
# Node/Vercel — do not set manually in .env.local.
